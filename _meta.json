    "数据整理",
    "表格规范化",
    "脏数据",
    "数据预处理"
  ],
  "entry": "SKILL.md",
  "scripts": [
    "scripts/clean_tab.py"
  ],
  "references": [
    "references/01-数据质量维度与术语.md",
    "references/02-常见脏数据模式手册.md",
    "references/03-清洗规则与标准化清单.md",
    "references/04-字段类型推断与转换.md",
    "references/05-清洗后质检SOP.md"
  ],
