{
  "name": "data-cleaner",
  "display_name": "表格数据清洗器",
  "version": "1.0.0",
  "category": "通用业务",
  "description": "把脏乱的 CSV/TSV 一键整理成干净规范数据：表头标准化、全角半角归一、货币/千分位/百分比还原、缺失值与占位符检测、重复行去重、字段类型推断，并输出可追溯的质检报告。纯本地、零外链。",
  "author": "局内人·老K",
  "license": "MIT",
  "compatibility": [
    "WorkBuddy",
    "Claude Code",
    "Cursor",
    "Codex",
    "OpenClaw",
    "通用SKILL.md宿主"
  ],
  "permissions": [
    "read_file",
    "write_file"
  ],
  "safety": "本地静态处理，不联网、不上传表格内容；原始文件始终保留不被覆盖",
  "triggers": [
    "清洗数据",
    "整理表格",
    "CSV太脏",
    "去重",
